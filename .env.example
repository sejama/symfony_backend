# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN PARA HOSTINGER (.env.local)
# Copia este archivo como .env.local en la raíz de tu proyecto Symfony en Hostinger
# ==============================================================================

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
# Genera un secreto aleatorio de 32 caracteres (ej: openssl rand -hex 16)
APP_SECRET=cambia_este_secreto_por_uno_aleatorio_32_caracteres
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://tudominio.com
###< symfony/routing ###

###> symfony/mailer ###
# Configuración para Hostinger Mail:
# - Servidor: smtp.hostinger.com
# - Puerto 465 (SSL): smtps://usuario%40tudominio.com:password@smtp.hostinger.com:465
# - Puerto 587 (TLS): smtp://usuario%40tudominio.com:password@smtp.hostinger.com:587
# NOTA: Si el usuario contiene '@', debe codificarse como '%40' en la URL.
MAILER_DSN=smtps://notificaciones%40tudominio.com:TuPasswordSeguro@smtp.hostinger.com:465

# Remitente por defecto (debe coincidir con la casilla creada en Hostinger para pasar SPF/DKIM)
MAILER_DEFAULT_FROM_EMAIL=notificaciones@tudominio.com
MAILER_DEFAULT_FROM_NAME="Tu Empresa o Proyecto"
###< symfony/mailer ###

###> api/security ###
# Clave secreta para proteger el endpoint /api/email/send.
# Los clientes deben enviar el header: X-API-KEY: tu_clave_aqui (o Authorization: Bearer ...)
# Si se deja vacía, el endpoint es público (con rate limiting por IP).
MAIL_API_KEY=tu_clave_api_secreta_aqui

# Orígenes CORS permitidos (separados por coma para múltiples orígenes, o * para todos)
CORS_ALLOW_ORIGIN=https://tudominio.com,https://www.tudominio.com

# Activar o desactivar filtro anti-spam (true / false)
EMAIL_SPAM_CHECK_ENABLED=true
###< api/security ###

###> doctrine/doctrine-bundle ###
# Base de datos SQLite local (no requiere configurar base de datos en Hostinger si no se usa)
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_prod.db"

# Si decides usar la base de datos MySQL de Hostinger:
# DATABASE_URL="mysql://uXXXXX_user:Password@127.0.0.1:3306/uXXXXX_dbname?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
